{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "tool-dev-mindsparkle"
    }
  ],
  "optional_executas": [],
  "host_capabilities": ["llm.sample", "aps.kv", "host.upload"],
  "system_prompt_addendum": "The user has MindSparkle open. Help them learn from documents using summarize, quiz, presentation, guide, and study. Keep answers clear and educational.",
  "user_message_prefix_template": "[MindSparkle] {user_message}",
  "tags": ["education", "study", "quiz", "summary", "learning", "mindsparkle"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "MindSparkle",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 480, "h": 640 },
        "default_size": { "w": 1080, "h": 760 },
        "max_size": { "w": 1600, "h": 1100 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:*"],
      "chat": ["write_message"],
      "storage": ["get", "set", "delete", "list"],
      "llm": ["complete"],
      "upload": ["inline", "negotiate", "confirm"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "img-src": ["'self'", "data:", "blob:"],
      "font-src": ["'self'", "data:"],
      "style-src": ["'self'"],
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
